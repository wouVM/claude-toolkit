{
  "tracker": {
    "kind": "jira",
    "project": "<PROJECT_KEY>",
    "draft_status": "Triage",
    "signed_status": "Ready for Dev",
    "in_progress_status": "In Progress",
    "pickup_label": "auto-fix",
    "in_flight_label": "in-flight"
  },
  "repos": [
    {
      "name": "api",
      "path": "<PATH_TO_SUB_REPO>",
      "base": "main",
      "branch_format": "<type>/<ticket>/<slug>"
    }
  ],
  "worktree_root": "../worktrees",
  "verify": "/verify all",
  "diagnosis_kinds": ["config", "code"],
  "routes": {
    "config": {
      "skill": "<CONFIG_FIX_SKILL>",
      "max_autonomy": "pr"
    },
    "code": {
      "skill": null,
      "max_autonomy": "plan",
      "reason": "<AREA> beyond trivial fixes is owned by <OWNER>"
    }
  },
  "review": {
    "reviewers": ["codex review", "gemini review"],
    "taste_gate": "springclean",
    "max_rounds": 2
  },
  "relations": {
    "closed_window_days": 180,
    "regression_label": "regression"
  },
  "lens_trail": {
    "post_comments": true,
    "sidecar": "docs/<ticket>-review.md"
  },
  "pr": {
    "skill": "<PR_SKILL>",
    "never_merge": true
  }
}
